# ============================================
# Portfolio Template - Environment Variables
# ============================================
# Copy this file to .env.local and update the values
# cp .env.example .env.local

# ============================================
# DATABASE
# ============================================
# For local development, use SQLite (no setup needed):
DATABASE_URL="file:./dev.db"

# For production, use PostgreSQL:
# DATABASE_URL="postgresql://username:password@localhost:5432/portfolio_db"

# ============================================
# AUTHENTICATION (NextAuth)
# ============================================
# Local development URL
NEXTAUTH_URL="http://localhost:3000"

# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# ============================================
# CLOUDINARY (Image Upload) - Optional
# ============================================
# Sign up at: https://cloudinary.com/
# Leave empty to disable image upload feature
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ============================================
# ADMIN CREDENTIALS (for seeding)
# ============================================
# These are used when running: npm run db:seed
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin@123"

# ============================================
# EMAIL (Optional - for contact form)
# ============================================
# Gmail SMTP settings (enable 2FA and create App Password)
# EMAIL_SERVER_HOST="smtp.gmail.com"
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER="your-email@gmail.com"
# EMAIL_SERVER_PASSWORD="your-app-password"
# EMAIL_FROM="your-email@gmail.com"

# ============================================
# WEB3FORMS (Optional - contact form backup)
# ============================================
# Sign up at: https://web3forms.com/
NEXT_PUBLIC_WEB3FORMS_KEY=""

# ============================================
# NODE ENVIRONMENT
# ============================================
# development | production
NODE_ENV="development"
